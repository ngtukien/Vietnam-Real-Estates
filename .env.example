# Dataset Hugging Face và số dòng đầu dùng cho notebook/chatbot.
DATASET=tinixai/vietnam-real-estates
N_ROWS=20000
# REBUILD=1 tính lại mọi cell CACHE thay vì đọc file đã lưu.
REBUILD=0

# Qdrant và Neo4j (docker compose up -d). Bản đầy đủ: docker compose --profile full up -d.
QDRANT_URL=http://127.0.0.1:6333
NEO4J_PASSWORD=local_dev_password

# Khoá Claude cho bộ lọc, sinh câu trả lời, Text2Cypher, router; hoặc chạy `ant auth login`.
# Không ghi khoá vào notebook.
# ANTHROPIC_API_KEY=
# LLM_TIMEOUT=120
# Mô hình chấm điểm ở notebook 04; nên khác mô hình sinh. Để trống: dùng LLM_MODEL.
# JUDGE_MODEL=

# Truy xuất: RERANK=1 bật cross-encoder trong retrieve() (chậm hơn, chính xác hơn).
# RERANK=0
# RERANK_CANDIDATES=20
# QDRANT_OVERSAMPLING=2.0

# Text2Cypher: Neo4j huỷ câu Cypher chạy quá CYPHER_TIMEOUT giây; chỉ đọc CYPHER_MAX_ROWS dòng.
# CYPHER_TIMEOUT=10
# CYPHER_MAX_ROWS=50

# Chatbot (app/server.py). CHAT_API_TOKEN bắt buộc khi mở server ra ngoài 127.0.0.1.
# CHAT_MAX_CONCURRENT=4
# CHAT_RATE_PER_MIN=20
# CHAT_MAX_QUERY_CHARS=500
# CHAT_API_TOKEN=
