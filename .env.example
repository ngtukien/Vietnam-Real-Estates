# Dataset Hugging Face và số dòng đầu dùng cho notebook/chatbot.
DATASET=tinixai/vietnam-real-estates
N_ROWS=20000
# REBUILD=1 tính lại mọi cell CACHE thay vì đọc file đã lưu.
REBUILD=0

# Qdrant và Neo4j (docker compose up -d). Bản đầy đủ: docker compose --profile full up -d.
QDRANT_URL=http://127.0.0.1:6333
NEO4J_PASSWORD=local_dev_password

# LLM cho bộ lọc, sinh câu trả lời, Text2Cypher, router: Groq (API tương thích OpenAI).
# Tạo khoá tại console.groq.com. Không ghi khoá vào notebook.
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
# Mô hình chấm điểm ở notebook 04; khác mô hình sinh để tránh tự chấm thiên vị.
JUDGE_MODEL=openai/gpt-oss-20b
# LLM_TIMEOUT=120
# Giá USD cho 1 triệu token vào/ra của LLM_MODEL (bảng chi phí P4-12); kiểm tra tại groq.com/pricing.
# LLM_PRICE_INPUT=0.15
# LLM_PRICE_OUTPUT=0.60
# Tuỳ chọn khác: LLM_PROVIDER=openai (OPENAI_API_KEY) hoặc =anthropic (ANTHROPIC_API_KEY).

# Truy xuất: RERANK=1 bật cross-encoder trong retrieve() (chậm hơn, chính xác hơn).
# RERANK=0
# RERANK_CANDIDATES=20
# QDRANT_OVERSAMPLING=2.0

# Text2Cypher: Neo4j huỷ câu Cypher chạy quá CYPHER_TIMEOUT giây; chỉ đọc CYPHER_MAX_ROWS dòng.
# CYPHER_TIMEOUT=10
# CYPHER_MAX_ROWS=50

# Chatbot (app/server.py). CHAT_API_TOKEN bắt buộc khi mở server ra ngoài 127.0.0.1.
# CHAT_MAX_CONCURRENT=4
# CHAT_RATE_PER_MIN=20
# CHAT_MAX_QUERY_CHARS=500
# CHAT_API_TOKEN=
